<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hardware In-Call Power Button Behavior:
         0 = Nothing
         1 = Turn off display
         2 = Hang up / End call (Red End Call button on Cat S22 Flip) -->
    <integer name="config_inCallPowerBehavior">2</integer>
    <bool name="config_endcallBehavior">true</bool>

    <!-- Flip / Lid Behavior:
         0 = Nothing
         1 = Sleep / Screen off when closed
         2 = Lock device when closed -->
    <integer name="config_lidKeyboardAccessibility">0</integer>
    <integer name="config_lidNavigationAccessibility">0</integer>
    <integer name="config_lidOpenRotation">-1</integer>
    <integer name="config_lidControlsSleep">0</integer>
    <integer name="config_lidControlsScreenOff">0</integer>

    <!-- Navigation Bar:
         Cat S22 Flip has physical D-pad and Back/Home/Recent keys.
         Disable software on-screen navigation bar completely. -->
    <bool name="config_showNavigationBar">false</bool>

    <!-- Physical Keypad & D-Pad Navigation Tweaks -->
    <!-- Draw high-visibility focus highlight on active views for D-Pad/Tab navigation -->
    <bool name="config_defaultFocusHighlightEnabled">true</bool>
    <!-- Tell InputMethodManager physical keypad has permanent menu/navigation capabilities -->
    <bool name="config_hasPermanentMenuKey">true</bool>
    <bool name="config_hasKeyboard">true</bool>
    <integer name="config_keyboardType">1</integer>
    <!-- Play key sound click on physical keypad entry -->
    <bool name="config_sendAudioWhenHardwareKeyboardUsed">true</bool>
    <!-- Route volume keys directly via WindowManager -->
    <bool name="config_handleVolumeKeysInWindowManager">true</bool>

    <!-- Display & Screen Metrics for Compact 2.8" 480x640 Display -->
    <bool name="config_automatic_brightness_available">false</bool>
    <dimen name="rounded_corner_radius">0dp</dimen>
    <dimen name="rounded_corner_radius_top">0dp</dimen>
    <dimen name="rounded_corner_radius_bottom">0dp</dimen>
    <!-- Proportional 20dp Status Bar -->
    <dimen name="status_bar_height_portrait">20dp</dimen>
    <dimen name="status_bar_height">20dp</dimen>
    <dimen name="navigation_bar_height">0dp</dimen>
    <dimen name="navigation_bar_height_landscape">0dp</dimen>
    <dimen name="navigation_bar_frame_height">0dp</dimen>

    <!-- Force 60Hz display refresh rate -->
    <integer name="config_defaultRefreshRate">60</integer>
    <integer name="config_defaultPeakRefreshRate">60</integer>

    <!-- Cellular, IMS & VoLTE Carrier Overrides:
         Forces VoLTE / 4G Calling settings availability and registers IMS on boot -->
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_carrier_volte_tty_supported">true</bool>
    <bool name="config_carrier_wfc_ims_available">true</bool>
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_ims_available">true</bool>
    <bool name="config_dynamic_bind_ims">true</bool>

    <!-- Audio Volume Steps:
         Increased to 25/30 steps for granular speaker and earpiece control -->
    <integer name="config_audio_vol_steps_call">25</integer>
    <integer name="config_audio_vol_steps_music">30</integer>
</resources>
